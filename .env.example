# Supabase project (Capabilio Recruiter, id xogmrwpnkmdmjvwpmfzc)
SUPABASE_URL=https://xogmrwpnkmdmjvwpmfzc.supabase.co
# Service role (secret) key -- Project Settings -> API -> service_role.
# NEVER expose this to the frontend. Backend-only.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key for resume scoring + feedback generation
ANTHROPIC_API_KEY=

# Resend (transactional email) -- DNS already has resend._domainkey + send SPF
# configured on capabilio.online
RESEND_API_KEY=
EMAIL_FROM="Capabilio Recruiting <feedback@send.capabilio.online>"

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=https://recruiter.capabilio.online,http://localhost:5173

PORT=3000

# Partner bridge to capabilio-web (students/professionals/colleges live
# there, in a separate Supabase project). This backend calls it
# server-to-server; PARTNER_BRIDGE_SECRET must match the same value set on
# capabilio-web's own backend deployment.
CAPABILIO_WEB_API_URL=
PARTNER_BRIDGE_SECRET=
